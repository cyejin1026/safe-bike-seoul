# Server-only keys: never prefix these with NEXT_PUBLIC_.
SEOUL_API_KEY=replace_with_seoul_openapi_key
# Public Data Portal key used by the Korea Road Traffic Authority and KMA APIs.
DATA_GO_KR_API_KEY=replace_with_public_data_portal_service_key
KAKAO_REST_API_KEY=replace_with_kakao_rest_api_key

# Kakao Maps JavaScript SDK requires a browser key. Restrict its allowed domains
# in Kakao Developers. Do not put REST or public data portal keys here.
NEXT_PUBLIC_KAKAO_JS_KEY=replace_with_kakao_javascript_key
